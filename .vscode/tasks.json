
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run C++",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -std=c++23 -O2 -Wall \"${file}\" -o \"${fileDirname}/main\" && \"${fileDirname}/main\" < \"${fileDirname}/input.txt\" > \"${fileDirname}/output.txt\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
